{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "一梦音乐播放器",
  "mainBinaryName": "clx-music-player",
  "version": "1.0.2",
  "identifier": "com.easterdon",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "一梦音乐播放器",
        "minWidth": 400,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "EasterDon",
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "一梦音乐播放器",
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": null,
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": {
          "zh-CN": {
            "localePath": "../wix/locales/zh-CN.wxl"
          }
        },
        "upgradeCode": "7d0a6d85-e08f-58b7-bdf5-aa10b61ce3b7",
        "template": "../wix/main.wxs"
      }
    }
  }
}
